  "narrative": {
    "northStar": "The Quiet Consulting Room",
    "overview": "The page behaves like the room it advertises: pearl walls, graphite furniture, one small piece of gold, and her face as the warmest thing in view. Nothing shouts. Trust comes from space, from patients' own words in large type, and from a single obvious action (WhatsApp) repeated calmly.",
    "keyCharacteristics": [
      "Cool pearl ground, graphite ink, one matte-gold accent used for graphics, filets and hover fills.",
      "Sans-only type: Outfit for voice, Figtree for reading.",
      "16px tiles and pill buttons; no shadows at rest.",
      "Light by default, dark mode automatic with the same token names."
    ],
    "rules": [
      {
        "name": "The One Gold Rule",
        "body": "Gold is the only accent. It appears as graphic marks, filets and hover fills, and the text-safe Gold Ink handles any gold that must be read.",
        "section": "colors"
      },
      {
        "name": "The Pearl Not Cream Rule",
        "body": "The ground stays cool and near-white. Warmth is allowed in one tinted tile per section, never in the page field.",
        "section": "colors"
      },
      {
        "name": "The Same Family Rule",
        "body": "Emphasis is weight or size inside Outfit or Figtree; no mixed-family flourishes.",
        "section": "typography"
      },
      {
        "name": "The No Eyebrow Rule",
        "body": "Headings stand alone, without small labels above them.",
        "section": "typography"
      },
      {
        "name": "The Flat At Rest Rule",
        "body": "Surfaces carry no shadow until a state asks for one.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do send every call to action to WhatsApp, with a message that matches the section.",
      "Do keep patients' reviews verbatim, with their Google attribution.",
      "Do use Gold Ink (#7A5F2B) whenever gold text is needed on a light ground.",
      "Do keep one gold-tinted tile per section at most."
    ],
    "donts": [
      "Don't publish session prices, opening hours or statistics that are not in her own sources.",
      "Don't introduce a second accent, a serif face, or gradient text.",
      "Don't put eyebrow labels above headings or number the sections.",
      "Don't use shadows at rest or hard offset shadows."
    ]
  }
